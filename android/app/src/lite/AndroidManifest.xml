<?xml version="1.0" encoding="utf-8"?>
<!-- Lite build: no notification listener, so Play Protect lets a browser or
     WhatsApp install it. Payment detection asks to switch to the full build. -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">
    <application>
        <service
            android:name=".detect.PaymentListenerService"
            tools:node="remove" />
    </application>
</manifest>
