<?xml version="1.0" encoding="utf-8"?>
<!-- Quick-add widget, medium: amount and the category "dropdown" (opens the
     picker sheet), a bigger keypad and the save bar. QuickAddWidget picks it by size. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root"
    android:layoutDirection="rtl"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_bg"
    android:orientation="vertical"
    android:padding="12dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="4dp">
        <TextView
            android:id="@+id/amount"
            android:layout_width="0dp"
            android:layout_height="40dp"
            android:layout_weight="1"
            android:ellipsize="end"
            android:fontFamily="@font/rubik_extrabold"
            android:gravity="start|center_vertical"
            android:includeFontPadding="false"
            android:maxLines="1"
            android:text="₪0"
            android:textColor="@color/w_ink_dim"
            android:textDirection="ltr"
            android:autoSizeMaxTextSize="30sp"
            android:autoSizeMinTextSize="12sp"
            android:autoSizeTextType="uniform"
            android:textSize="30sp" />
        <LinearLayout
            android:id="@+id/category_chip"
            android:layout_width="wrap_content"
            android:layout_height="38dp"
            android:layout_marginStart="8dp"
            android:background="@drawable/widget_chip"
            android:contentDescription="קטגוריה"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="5dp"
            android:paddingEnd="8dp">
            <FrameLayout
                android:layout_width="28dp"
                android:layout_height="28dp">
                <ImageView
                    android:id="@+id/chip_tint"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:importantForAccessibility="no"
                    android:src="@drawable/widget_circle" />
                <ImageView
                    android:id="@+id/chip_sticker"
                    android:layout_width="17dp"
                    android:layout_height="17dp"
                    android:layout_gravity="center"
                    android:importantForAccessibility="no" />
                <TextView
                    android:id="@+id/chip_letter"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:fontFamily="@font/rubik_extrabold"
                    android:gravity="center"
                    android:textColor="@color/w_ink"
                    android:textSize="13sp"
                    android:visibility="gone" />
            </FrameLayout>
            <TextView
                android:id="@+id/chip_name"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:ellipsize="end"
                android:fontFamily="@font/rubik_extrabold"
                android:maxLines="1"
                android:maxWidth="96dp"
                android:textColor="@color/w_ink"
                android:textSize="13.5sp" />
            <ImageView
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:layout_marginStart="3dp"
                android:importantForAccessibility="no"
                android:src="@drawable/ic_w_chevron_down" />
        </LinearLayout>
    </LinearLayout>

    <LinearLayout
        android:id="@+id/keypad"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="8dp"
        android:layout_weight="1"
        android:layoutDirection="ltr"
        android:orientation="vertical">
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:orientation="horizontal">
            <TextView
                android:id="@+id/key_1"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:layout_marginEnd="5dp"
                android:background="@drawable/widget_key"
                android:fontFamily="@font/rubik_extrabold"
                android:gravity="center"
                android:includeFontPadding="false"
                android:text="1"
                android:textColor="@color/w_ink"
                android:textSize="22sp" />
            <TextView
                android:id="@+id/key_2"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:layout_marginEnd="5dp"
                android:background="@drawable/widget_key"
                android:fontFamily="@font/rubik_extrabold"
                android:gravity="center"
                android:includeFontPadding="false"
                android:text="2"
                android:textColor="@color/w_ink"
                android:textSize="22sp" />
            <TextView
                android:id="@+id/key_3"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:background="@drawable/widget_key"
                android:fontFamily="@font/rubik_extrabold"
                android:gravity="center"
                android:includeFontPadding="false"
                android:text="3"
                android:textColor="@color/w_ink"
                android:textSize="22sp" />
        </LinearLayout>
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:layout_marginTop="5dp"
            android:orientation="horizontal">
            <TextView
                android:id="@+id/key_4"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:layout_marginEnd="5dp"
                android:background="@drawable/widget_key"
                android:fontFamily="@font/rubik_extrabold"
                android:gravity="center"
                android:includeFontPadding="false"
                android:text="4"
                android:textColor="@color/w_ink"
                android:textSize="22sp" />
            <TextView
                android:id="@+id/key_5"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:layout_marginEnd="5dp"
                android:background="@drawable/widget_key"
                android:fontFamily="@font/rubik_extrabold"
                android:gravity="center"
                android:includeFontPadding="false"
                android:text="5"
                android:textColor="@color/w_ink"
                android:textSize="22sp" />
            <TextView
                android:id="@+id/key_6"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:background="@drawable/widget_key"
                android:fontFamily="@font/rubik_extrabold"
                android:gravity="center"
                android:includeFontPadding="false"
                android:text="6"
                android:textColor="@color/w_ink"
                android:textSize="22sp" />
        </LinearLayout>
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:layout_marginTop="5dp"
            android:orientation="horizontal">
            <TextView
                android:id="@+id/key_7"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:layout_marginEnd="5dp"
                android:background="@drawable/widget_key"
                android:fontFamily="@font/rubik_extrabold"
                android:gravity="center"
                android:includeFontPadding="false"
                android:text="7"
                android:textColor="@color/w_ink"
                android:textSize="22sp" />
            <TextView
                android:id="@+id/key_8"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:layout_marginEnd="5dp"
                android:background="@drawable/widget_key"
                android:fontFamily="@font/rubik_extrabold"
                android:gravity="center"
                android:includeFontPadding="false"
                android:text="8"
                android:textColor="@color/w_ink"
                android:textSize="22sp" />
            <TextView
                android:id="@+id/key_9"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:background="@drawable/widget_key"
                android:fontFamily="@font/rubik_extrabold"
                android:gravity="center"
                android:includeFontPadding="false"
                android:text="9"
                android:textColor="@color/w_ink"
                android:textSize="22sp" />
        </LinearLayout>
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:layout_marginTop="5dp"
            android:orientation="horizontal">
            <TextView
                android:id="@+id/key_dot"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:layout_marginEnd="5dp"
                android:background="@drawable/widget_key"
                android:fontFamily="@font/rubik_extrabold"
                android:gravity="center"
                android:includeFontPadding="false"
                android:text="."
                android:textColor="@color/w_ink"
                android:textSize="22sp" />
            <TextView
                android:id="@+id/key_0"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:layout_marginEnd="5dp"
                android:background="@drawable/widget_key"
                android:fontFamily="@font/rubik_extrabold"
                android:gravity="center"
                android:includeFontPadding="false"
                android:text="0"
                android:textColor="@color/w_ink"
                android:textSize="22sp" />
            <ImageView
                android:id="@+id/key_del"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:background="@drawable/widget_key"
                android:contentDescription="מחק"
                android:scaleType="center"
                android:src="@drawable/ic_w_backspace" />
        </LinearLayout>
    </LinearLayout>

    <TextView
        android:id="@+id/save"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginTop="8dp"
        android:background="@drawable/widget_btn_disabled"
        android:fontFamily="@font/rubik_extrabold"
        android:gravity="center"
        android:maxLines="1"
        android:paddingHorizontal="12dp"
        android:paddingBottom="4dp"
        android:text="שמור"
        android:textColor="@color/w_ink_dim"
        android:autoSizeMaxTextSize="15.5sp"
        android:autoSizeMinTextSize="11sp"
        android:autoSizeTextType="uniform"
        android:textSize="15.5sp" />
</LinearLayout>
