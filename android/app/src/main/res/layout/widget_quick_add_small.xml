<?xml version="1.0" encoding="utf-8"?>
<!-- Quick-add widget, small: the numbers first. Amount, the category
     "dropdown" (sticker only) and a round save button, then the keypad. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root"
    android:layoutDirection="rtl"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_bg"
    android:orientation="vertical"
    android:padding="10dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="4dp">
        <TextView
            android:id="@+id/amount"
            android:layout_width="0dp"
            android:layout_height="38dp"
            android:layout_weight="1"
            android:ellipsize="end"
            android:fontFamily="@font/rubik_extrabold"
            android:gravity="start|center_vertical"
            android:includeFontPadding="false"
            android:maxLines="1"
            android:text="₪0"
            android:textColor="@color/w_ink_dim"
            android:textDirection="ltr"
            android:autoSizeMaxTextSize="28sp"
            android:autoSizeMinTextSize="12sp"
            android:autoSizeTextType="uniform"
            android:textSize="28sp" />
        <LinearLayout
            android:id="@+id/category_chip"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:layout_marginStart="6dp"
            android:background="@drawable/widget_chip"
            android:contentDescription="קטגוריה"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="4dp"
            android:paddingEnd="5dp">
            <FrameLayout
                android:layout_width="28dp"
                android:layout_height="28dp">
                <ImageView
                    android:id="@+id/chip_tint"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:importantForAccessibility="no"
                    android:src="@drawable/widget_circle" />
                <ImageView
                    android:id="@+id/chip_sticker"
                    android:layout_width="17dp"
                    android:layout_height="17dp"
                    android:layout_gravity="center"
                    android:importantForAccessibility="no" />
                <TextView
                    android:id="@+id/chip_letter"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:fontFamily="@font/rubik_extrabold"
                    android:gravity="center"
                    android:textColor="@color/w_ink"
                    android:textSize="13sp"
                    android:visibility="gone" />
            </FrameLayout>
            <ImageView
                android:layout_width="12dp"
                android:layout_height="12dp"
                android:layout_marginStart="2dp"
                android:importantForAccessibility="no"
                android:src="@drawable/ic_w_chevron_down" />
        </LinearLayout>
        <TextView
            android:id="@+id/save"
            android:layout_width="40dp"
            android:layout_height="44dp"
            android:layout_marginStart="6dp"
            android:background="@drawable/widget_btn_disabled"
            android:contentDescription="שמור"
            android:fontFamily="@font/rubik_extrabold"
            android:gravity="center"
            android:paddingBottom="4dp"
            android:text="✓"
            android:textColor="@color/w_ink_dim"
            android:textSize="19sp" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="8dp"
        android:layout_weight="1"
        android:layoutDirection="ltr"
        android:orientation="vertical">
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:orientation="horizontal">
            <TextView
                android:id="@+id/key_1"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:layout_marginEnd="4dp"
                android:background="@drawable/widget_key"
                android:fontFamily="@font/rubik_extrabold"
                android:gravity="center"
                android:includeFontPadding="false"
                android:text="1"
                android:textColor="@color/w_ink"
                android:textSize="20sp" />
            <TextView
                android:id="@+id/key_2"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:layout_marginEnd="4dp"
                android:background="@drawable/widget_key"
                android:fontFamily="@font/rubik_extrabold"
                android:gravity="center"
                android:includeFontPadding="false"
                android:text="2"
                android:textColor="@color/w_ink"
                android:textSize="20sp" />
            <TextView
                android:id="@+id/key_3"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:background="@drawable/widget_key"
                android:fontFamily="@font/rubik_extrabold"
                android:gravity="center"
                android:includeFontPadding="false"
                android:text="3"
                android:textColor="@color/w_ink"
                android:textSize="20sp" />
        </LinearLayout>
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:layout_marginTop="4dp"
            android:orientation="horizontal">
            <TextView
                android:id="@+id/key_4"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:layout_marginEnd="4dp"
                android:background="@drawable/widget_key"
                android:fontFamily="@font/rubik_extrabold"
                android:gravity="center"
                android:includeFontPadding="false"
                android:text="4"
                android:textColor="@color/w_ink"
                android:textSize="20sp" />
            <TextView
                android:id="@+id/key_5"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:layout_marginEnd="4dp"
                android:background="@drawable/widget_key"
                android:fontFamily="@font/rubik_extrabold"
                android:gravity="center"
                android:includeFontPadding="false"
                android:text="5"
                android:textColor="@color/w_ink"
                android:textSize="20sp" />
            <TextView
                android:id="@+id/key_6"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:background="@drawable/widget_key"
                android:fontFamily="@font/rubik_extrabold"
                android:gravity="center"
                android:includeFontPadding="false"
                android:text="6"
                android:textColor="@color/w_ink"
                android:textSize="20sp" />
        </LinearLayout>
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:layout_marginTop="4dp"
            android:orientation="horizontal">
            <TextView
                android:id="@+id/key_7"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:layout_marginEnd="4dp"
                android:background="@drawable/widget_key"
                android:fontFamily="@font/rubik_extrabold"
                android:gravity="center"
                android:includeFontPadding="false"
                android:text="7"
                android:textColor="@color/w_ink"
                android:textSize="20sp" />
            <TextView
                android:id="@+id/key_8"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:layout_marginEnd="4dp"
                android:background="@drawable/widget_key"
                android:fontFamily="@font/rubik_extrabold"
                android:gravity="center"
                android:includeFontPadding="false"
                android:text="8"
                android:textColor="@color/w_ink"
                android:textSize="20sp" />
            <TextView
                android:id="@+id/key_9"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:background="@drawable/widget_key"
                android:fontFamily="@font/rubik_extrabold"
                android:gravity="center"
                android:includeFontPadding="false"
                android:text="9"
                android:textColor="@color/w_ink"
                android:textSize="20sp" />
        </LinearLayout>
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:layout_marginTop="4dp"
            android:orientation="horizontal">
            <TextView
                android:id="@+id/key_dot"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:layout_marginEnd="4dp"
                android:background="@drawable/widget_key"
                android:fontFamily="@font/rubik_extrabold"
                android:gravity="center"
                android:includeFontPadding="false"
                android:text="."
                android:textColor="@color/w_ink"
                android:textSize="20sp" />
            <TextView
                android:id="@+id/key_0"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:layout_marginEnd="4dp"
                android:background="@drawable/widget_key"
                android:fontFamily="@font/rubik_extrabold"
                android:gravity="center"
                android:includeFontPadding="false"
                android:text="0"
                android:textColor="@color/w_ink"
                android:textSize="20sp" />
            <ImageView
                android:id="@+id/key_del"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:background="@drawable/widget_key"
                android:contentDescription="מחק"
                android:scaleType="center"
                android:src="@drawable/ic_w_backspace" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
