<?xml version="1.0" encoding="utf-8"?>
<!-- The widget's category picker (the compact sizes' "dropdown") and new
     category field, as a bottom sheet in the app's style. Tiles and space
     pills are added in code (CategorySheetActivity). -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/scrim"
    android:layoutDirection="rtl"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:id="@+id/sheet"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:background="@drawable/widget_sheet"
        android:clickable="true"
        android:focusable="true"
        android:orientation="vertical"
        android:paddingStart="20dp"
        android:paddingTop="10dp"
        android:paddingEnd="20dp"
        android:paddingBottom="20dp">

        <View
            android:layout_width="40dp"
            android:layout_height="5dp"
            android:layout_gravity="center_horizontal"
            android:background="@drawable/widget_grabber" />

        <TextView
            android:id="@+id/title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:fontFamily="@font/rubik_extrabold"
            android:textColor="@color/w_ink"
            android:textDirection="anyRtl"
            android:textSize="23sp" />

        <TextView
            android:id="@+id/subtitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="3dp"
            android:fontFamily="@font/rubik_semibold"
            android:textColor="@color/w_ink_dim"
            android:textSize="14sp" />

        <HorizontalScrollView
            android:id="@+id/spaces_scroll"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:scrollbars="none">

            <LinearLayout
                android:id="@+id/spaces"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal" />
        </HorizontalScrollView>

        <ScrollView
            android:id="@+id/grid_scroll"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:scrollbars="none">

            <GridLayout
                android:id="@+id/grid"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:columnCount="3"
                android:useDefaultMargins="false" />
        </ScrollView>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <FrameLayout
                android:layout_width="52dp"
                android:layout_height="52dp">

                <ImageView
                    android:id="@+id/new_tint"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:importantForAccessibility="no"
                    android:src="@drawable/widget_circle" />

                <ImageView
                    android:id="@+id/new_sticker"
                    android:layout_width="29dp"
                    android:layout_height="29dp"
                    android:layout_gravity="center"
                    android:importantForAccessibility="no" />

                <TextView
                    android:id="@+id/new_letter"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:fontFamily="@font/rubik_extrabold"
                    android:gravity="center"
                    android:textColor="@color/w_ink"
                    android:textSize="21sp"
                    android:visibility="gone" />
            </FrameLayout>

            <EditText
                android:id="@+id/name"
                android:layout_width="0dp"
                android:layout_height="52dp"
                android:layout_marginStart="10dp"
                android:layout_weight="1"
                android:background="@drawable/widget_field"
                android:fontFamily="@font/rubik_semibold"
                android:hint="קטגוריה חדשה"
                android:imeOptions="actionDone"
                android:importantForAutofill="no"
                android:inputType="text"
                android:maxLength="24"
                android:maxLines="1"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:textColor="@color/w_ink"
                android:textColorHint="@color/w_ink_dim"
                android:textSize="16sp" />
        </LinearLayout>

        <TextView
            android:id="@+id/add"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="14dp"
            android:background="@drawable/widget_btn_disabled"
            android:fontFamily="@font/rubik_extrabold"
            android:gravity="center"
            android:paddingBottom="4dp"
            android:text="הוסף"
            android:textColor="@color/w_ink_dim"
            android:textDirection="anyRtl"
            android:textSize="16.5sp"
            android:visibility="gone" />
    </LinearLayout>
</FrameLayout>
