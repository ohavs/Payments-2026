rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }

    // Each user can only read/write under their own /users/{uid} subtree.
    match /users/{uid}/{document=**} {
      allow read, write: if signedIn() && request.auth.uid == uid;
    }

    // Shared expense trackers.
    //
    // Access comes from one of two places:
    //   members[]        — full read/write on the tracker and its expenses.
    //   invitedEmails[]  — someone invited this Google account by email. They
    //                      may read the tracker (to see the invitation) and
    //                      accept it by adding themselves to members.
    //
    // The tracker id also doubles as an unguessable invite code: anyone holding
    // it may add themselves as a member. Either way a non-member's single
    // allowed write is limited to the membership fields.
    match /lists/{listId} {
      function isMember() {
        return request.auth.uid in resource.data.members;
      }
      function myEmail() {
        return request.auth.token.email != null ? request.auth.token.email.lower() : '';
      }
      function isInvited() {
        return myEmail() != '' && myEmail() in resource.data.get('invitedEmails', []);
      }
      // A non-member write may only touch membership, and may only add *itself*
      // to members — never drop existing members or change the owner.
      function joiningOnly() {
        return request.resource.data.ownerUid == resource.data.ownerUid
          && request.resource.data.members.hasAll(resource.data.members)
          && request.resource.data.members.hasOnly(resource.data.members.concat([request.auth.uid]))
          && request.resource.data.diff(resource.data).affectedKeys()
               .hasOnly(['members', 'memberInfo', 'invitedEmails']);
      }

      allow read: if signedIn() && (isMember() || isInvited());

      allow create: if signedIn()
        && request.resource.data.ownerUid == request.auth.uid
        && request.auth.uid in request.resource.data.members;

      allow update: if signedIn() && (isMember() || joiningOnly());

      allow delete: if signedIn() && request.auth.uid == resource.data.ownerUid;

      // Expenses belong to the tracker; members only.
      match /items/{itemId} {
        allow read, write: if signedIn()
          && request.auth.uid in get(/databases/$(database)/documents/lists/$(listId)).data.members;
      }
    }
  }
}
