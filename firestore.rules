rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }

    // Each user can only read/write under their own /users/{uid} subtree.
    match /users/{uid}/{document=**} {
      allow read, write: if signedIn() && request.auth.uid == uid;
    }

    // Shareable lists. A list is readable/writable by its members. Non-members
    // may perform exactly one write: adding themselves to `members` (joining via
    // the list id, which acts as an unguessable invite code). Owners can delete.
    match /lists/{listId} {
      allow read: if signedIn() && request.auth.uid in resource.data.members;

      allow create: if signedIn()
        && request.resource.data.ownerUid == request.auth.uid
        && request.auth.uid in request.resource.data.members;

      allow update: if signedIn() && (
        // existing member: full edit
        request.auth.uid in resource.data.members
        // joining: may only add self, cannot drop others or change owner
        || (
          request.resource.data.ownerUid == resource.data.ownerUid
          && request.resource.data.members.hasAll(resource.data.members)
          && request.resource.data.members.hasOnly(resource.data.members.concat([request.auth.uid]))
        )
      );

      allow delete: if signedIn() && request.auth.uid == resource.data.ownerUid;

      // Items belong to the list; any member may read/write them.
      match /items/{itemId} {
        allow read, write: if signedIn()
          && request.auth.uid in get(/databases/$(database)/documents/lists/$(listId)).data.members;
      }
    }
  }
}
